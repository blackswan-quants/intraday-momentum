    "from classes.backtest.engine_new import Momentum\n",
    "from backtesting import Backtest\n",
    "\n",
    "bt = Backtest(\n",
    "            data =df_spy,\n",
    "            strategy = Momentum,\n",
    "            cash = 100_000,\n",
    "            commission = 0.0035,\n",
    "            spread = 0.001,\n",
    "            )\n",
    "\n",
    "stats = bt.run()\n",
    "print(stats)\n",
    "bt.plot()"
   ]
